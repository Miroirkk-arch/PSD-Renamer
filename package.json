{
  "name": "psd-renamer",
  "version": "1.2.0",
  "private": true,
  "description": "Native Windows PSD layer renaming tool",
  "license": "MIT",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File native/dev.ps1",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File native/build.ps1",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File native/package-release.ps1",
    "release:prepare": "node native/prepare-release.cjs",
    "release:draft": "node native/prepare-release.cjs draft"
  },
  "dependencies": {
    "ag-psd": "30.1.1"
  },
  "devDependencies": {
    "@ant-design/icons-svg": "4.4.2"
  }
}
