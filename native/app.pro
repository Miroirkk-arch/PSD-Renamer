QT += widgets concurrent testlib svg network
CONFIG += c++20 release
CONFIG -= debug debug_and_release
CONFIG -= console
TEMPLATE = app
TARGET = PSD-Renamer
SOURCES = i18n.cpp locale-selftest.cpp main.cpp core.cpp window.cpp actions.cpp dictionary.cpp search.cpp updates.cpp selftest.cpp
HEADERS = i18n.h toolbarflow.h core.h window.h version.h
RESOURCES += icons.qrc locales.qrc
RESOURCES += dictionary.qrc
RESOURCES += theme.qrc
LIBS += -ldwmapi
RC_ICONS = ../assets/icon.ico
QMAKE_CXXFLAGS += -finput-charset=UTF-8 -fexec-charset=UTF-8
QMAKE_CXXFLAGS += -no-canonical-prefixes
QMAKE_LFLAGS += -no-canonical-prefixes
CONFIG -= testcase
QMAKE_LFLAGS_CONSOLE = -Wl,-subsystem,windows
LIBS += -lpsapi
